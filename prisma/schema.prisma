generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum DeliveryStatus {
  SCHEDULED
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

model PaymentEvent {
  id            String        @id @default(cuid())
  reference     String        @unique
  eventType     String
  amountMinor   Int
  currency      String
  status        PaymentStatus
  payload       Json
  processedAt   DateTime?
  createdAt     DateTime      @default(now())
  entitlement   Entitlement?
}

model Subscription {
  id                 String             @id @default(cuid())
  email              String
  paystackCustomerId String?
  paystackCode       String?
  planCode           String?
  status             SubscriptionStatus @default(PENDING)
  nextBillingAt      DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  entitlements       Entitlement[]
}

model Entitlement {
  id             String       @id @default(cuid())
  subscriptionId String
  paymentEventId String       @unique
  cycleStart     DateTime
  cycleEnd       DateTime
  loavesGranted  Int          @default(24)
  deliveriesGranted Int       @default(12)
  loavesUsed     Int          @default(0)
  deliveriesUsed Int          @default(0)
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  paymentEvent   PaymentEvent @relation(fields: [paymentEventId], references: [id])
  deliveries     Delivery[]
  @@unique([subscriptionId, cycleStart])
}

model Delivery {
  id            String         @id @default(cuid())
  entitlementId String
  deliveryDate  DateTime
  quantity      Int            @default(2)
  breadType     String         @default("mixed")
  zone          String         @default("seshego")
  status        DeliveryStatus @default(SCHEDULED)
  deliveredAt   DateTime?
  entitlement   Entitlement    @relation(fields: [entitlementId], references: [id])
  @@unique([entitlementId, deliveryDate])
}

model CommissionEntry {
  id          String   @id @default(cuid())
  reference   String
  lineKey     String
  saleType    String
  grossMinor  Int
  commissionMinor Int
  deliveryMinor Int @default(0)
  currency    String   @default("ZAR")
  createdAt   DateTime @default(now())
  @@unique([reference, lineKey])
}
