NODE_ENV=development
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-a-different-long-random-secret
DATABASE_URL=postgres://fakumoya:replace-with-a-strong-password@postgres:5432/fakumoya?sslmode=disable
STOREFRONT_URL=http://localhost:8000
# Keep these secret values out of source control. Paystack webhooks must be
# reachable at /hooks/payment/paystack_paystack and /hooks/paystack/subscriptions.
PAYSTACK_SECRET_KEY=
PAYSTACK_REVENUE_SHARE_SECRET=replace-with-a-long-random-secret
# The bakery's approved Paystack subaccount. It receives the balance after the
# server-calculated KhulaNode commission on once-off checkouts.
PAYSTACK_BAKERY_SUBACCOUNT_CODE=
# Monthly Bread Plan: R620 / 24 loaves / 12 deliveries.
PAYSTACK_MONTHLY_BREAD_PLAN_CODE=
# Only set this after Paystack confirms the split applies to recurring invoices.
PAYSTACK_ENABLE_RECURRING_SPLIT=false
PAYSTACK_SUBSCRIPTION_SPLIT_CODE=
