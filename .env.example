# Docker Compose PostgreSQL credentials (use a URL-safe password).
POSTGRES_PASSWORD=replace-with-a-strong-password
# These values also belong in apps/backend/.env; replace the placeholders there.
DATABASE_URL=postgres://fakumoya:replace-with-a-strong-password@postgres:5432/fakumoya?sslmode=disable
REDIS_URL=redis://redis:6379
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-a-different-long-random-secret
# Used to build the storefront; copy the key generated by the initial seed.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://medusa:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=dk
