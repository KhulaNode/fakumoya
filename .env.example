# Single environment file for Docker Compose, Medusa and the Next.js storefront.
# Copy to .env and replace every placeholder. Never commit the resulting file.
NODE_ENV=production
TZ=Africa/Johannesburg

# Private Docker services. Use the same URL-safe password in both variables.
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
DATABASE_URL=postgres://fakumoya:replace-with-a-strong-url-safe-password@postgres:5432/fakumoya?sslmode=disable
REDIS_URL=redis://redis:6379

# Public HTTPS origins. Set MEDUSA_BACKEND_URL and MEDUSA_ADMIN_URL to the
# separately routed Dokploy domains for the Medusa service.
STOREFRONT_URL=https://fakumoya.khulanode.com
MEDUSA_BACKEND_URL=https://api.fakumoya.khulanode.com
MEDUSA_ADMIN_URL=https://admin.fakumoya.khulanode.com
MEDUSA_INTERNAL_URL=http://medusa:9000
STORE_CORS=https://fakumoya.khulanode.com
ADMIN_CORS=https://admin.fakumoya.khulanode.com
AUTH_CORS=https://fakumoya.khulanode.com,https://admin.fakumoya.khulanode.com

JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-a-different-long-random-secret
AUTH_MFA_ENCRYPTION_KEY=replace-with-a-different-32-byte-random-secret

# These variables are embedded when the storefront image is built.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.fakumoya.khulanode.com
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=copy-the-production-key-from-medusa-admin
NEXT_PUBLIC_BASE_URL=https://fakumoya.khulanode.com
NEXT_PUBLIC_DEFAULT_REGION=za

# Paystack stays in test mode until a deliberate live-key change. The hosted
# checkout uses the backend secret only; do not put it in NEXT_PUBLIC_* values.
# In Paystack's Test settings use STOREFRONT_URL as Callback URL and
# https://fakumoya.khulanode.com/api/webhook/paystack as Webhook URL.
PAYSTACK_SECRET_KEY=sk_test_replace-with-paystack-test-secret
PAYSTACK_REVENUE_SHARE_SECRET=replace-with-a-third-long-random-secret
PAYSTACK_BAKERY_SUBACCOUNT_CODE=
# R620 / 24 loaves / 12 deliveries. PAYSTACK_PLAN_CODE is retained only for
# compatibility with earlier local setup; prefer the monthly name below.
PAYSTACK_MONTHLY_BREAD_PLAN_CODE=
PAYSTACK_PLAN_CODE=
PAYSTACK_ENABLE_RECURRING_SPLIT=false
PAYSTACK_SUBSCRIPTION_SPLIT_CODE=

# Optional storefront integrations. Leave blank unless intentionally enabled.
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_ADYEN_CLIENT_KEY=
NEXT_PUBLIC_ADYEN_ENVIRONMENT=test
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
